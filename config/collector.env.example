ASPNETCORE_HTTP_PORTS=8080
DOTNET_ENVIRONMENT=Development
LogLevel=Information
PalworldApi__BaseUrl=http://palworld:8212
PalworldApi__Admin__Username=admin
PalworldApi__Admin__Password=palmap-integration
# Documentation-only Development override. Replace with the Aspire host's reachable LAN IP.
# Production collectors omit Endpoint and use https://pal-map.com automatically.
PalmapIngest__Endpoint=http://192.0.2.10:5080/api/ingest/v1/snapshots
# Public format-valid demonstration credentials only. Replace both with an issued pair.
PalmapIngest__ClientId=pmc_AAAAAAAAAAAAAAAAAAAA
PalmapIngest__ClientSecret=BBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBB
# Public demonstration key only. Generate a unique 32-byte key and base64-encode it before real use.
PalmapIngest__PrivacyKey=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=
PalmapIngest__AllowInsecureHttp=true
Collector__PlayerLocationUpdateIntervalMs=5000
Collector__GameDataUpdateIntervalMs=30000
Collector__StageRefreshDistance=50000
Collector__ServerSettingsUpdateIntervalMs=3600000
Collector__FailureRetryIntervalMs=5000
Collector__PalworldHealthCacheDurationMs=5000
# Opt-in OpenTelemetry Prometheus scrape endpoint (HttpListener).
# The sample Compose stack enables this so local scrapes and integration tests work.
# Production images default to Enabled=false unless you set these explicitly.
PrometheusExporter__Enabled=true
PrometheusExporter__Host=+
PrometheusExporter__Port=9090
PrometheusExporter__SampleIntervalMs=15000
